VITE_DEMO_MODE=true
# Supabase backend (Project Settings > API). Leave empty to keep data in this browser only.
# The anon key is public by design; RLS protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Overpass mirror used when a route is outside the bundled ITB graph
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
